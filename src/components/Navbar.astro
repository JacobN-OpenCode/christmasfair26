---
import { eventInfo } from '../data/fairData';
---

<nav class="navbar">
  <div class="container nav-container">
    <a href="/" class="nav-brand">
      <span class="nav-brand-main">Ashford School</span>
      <span class="nav-brand-sub">Christmas Fair 2026</span>
    </a>
    <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation menu" aria-expanded="false">
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>
    <ul class="nav-menu" id="navMenu">
      <li class="nav-item">
        <a href="/" class="nav-link">Home</a>
      </li>
      <li class="nav-item">
        <a href="/programme" class="nav-link">Programme</a>
      </li>
      <li class="nav-item">
        <a href="/stalls" class="nav-link">Stalls</a>
      </li>
      <li class="nav-item">
        <a href="/visitor-info" class="nav-link">Visitor Info</a>
      </li>
      <li class="nav-item">
        <a href="/raffle" class="nav-link">Raffle</a>
      </li>
    </ul>
  </div>
</nav>

<script>
  const navToggle = document.getElementById('navToggle');
  const navMenu = document.getElementById('navMenu');
  
  if (navToggle && navMenu) {
    navToggle.addEventListener('click', () => {
      const isExpanded = navToggle.getAttribute('aria-expanded') === 'true';
      navToggle.setAttribute('aria-expanded', !isExpanded ? 'true' : 'false');
      navMenu.classList.toggle('active');
    });
    
    // Close menu when clicking on a link
    const navLinks = navMenu.querySelectorAll('.nav-link');
    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        navToggle.setAttribute('aria-expanded', 'false');
        navMenu.classList.remove('active');
      });
    });
  }
</script>

<style>
  .navbar {
    background: linear-gradient(135deg, var(--navy) 0%, #0f1f3a 100%);
    border-bottom: 3px solid var(--gold);
    box-shadow: 0 4px 20px rgba(22, 41, 74, 0.3);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(10px);
  }
  
  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    padding-bottom: 1rem;
    flex-wrap: wrap;
    gap: 1rem;
  }
  
  .nav-brand {
    display: flex;
    flex-direction: column;
    color: var(--white);
    font-family: var(--font-serif);
    line-height: 1.2;
  }
  
  .nav-brand-main {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  
  .nav-brand-sub {
    font-size: 0.9rem;
    font-weight: 500;
    opacity: 0.95;
    font-family: var(--font-sans);
  }
  
  .nav-toggle {
    display: none;
    background: transparent;
    border: 2px solid rgba(255, 255, 255, 0.3);
    padding: 0.5rem;
    border-radius: var(--radius-sm);
    color: var(--white);
  }
  
  .nav-toggle-bar {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--white);
    margin: 5px 0;
  }
  
  .nav-menu {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 2rem;
    align-items: center;
    flex-wrap: wrap;
  }
  
  .nav-link {
    color: var(--white);
    font-weight: 500;
    font-size: 0.95rem;
    padding: 0.5rem 0;
    position: relative;
    transition: opacity 0.2s ease;
  }
  
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--gold);
    transition: width 0.3s ease;
  }
  
  .nav-link:hover {
    opacity: 0.9;
  }
  
  .nav-link:hover::after {
    width: 100%;
  }
  
  @media (max-width: 768px) {
    .nav-toggle {
      display: block;
    }
    
    .nav-menu {
      display: none;
      width: 100%;
      flex-direction: column;
      gap: 0;
      background: rgba(15, 31, 58, 0.98);
      border-radius: var(--radius-md);
      padding: 0.5rem 0;
      margin-top: 0.5rem;
    }
    
    .nav-menu.active {
      display: flex;
    }
    
    .nav-item {
      width: 100%;
    }
    
    .nav-link {
      display: block;
      padding: 0.75rem 1rem;
      width: 100%;
    }
    
    .nav-link::after {
      display: none;
    }
  }
</style>
