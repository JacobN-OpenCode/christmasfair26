---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { eventInfo, programme, allStalls } from '../data/fairData';
---

<BaseLayout>
  <Navbar />
  
  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-decoration hero-decoration-1">🎄</div>
      <div class="hero-decoration hero-decoration-2">❄️</div>
      <div class="hero-decoration hero-decoration-3">⭐</div>
      <div class="container hero-container">
        <div class="hero-content">
          <p class="hero-eyebrow">Ashford School Parents & Friends Association</p>
          <h1 class="hero-title">Christmas Fair 2026</h1>
          <p class="hero-subtitle">A magical day of festive fun for the whole family</p>
          
          <div class="hero-details">
            <div class="hero-detail-card">
              <span class="hero-detail-icon">📅</span>
              <div>
                <div class="hero-detail-label">Date</div>
                <div class="hero-detail-value">{eventInfo.date}</div>
              </div>
            </div>
            <div class="hero-detail-card">
              <span class="hero-detail-icon">🕐</span>
              <div>
                <div class="hero-detail-label">Time</div>
                <div class="hero-detail-value">{eventInfo.time}</div>
              </div>
            </div>
            <div class="hero-detail-card">
              <span class="hero-detail-icon">📍</span>
              <div>
                <div class="hero-detail-label">Location</div>
                <div class="hero-detail-value">{eventInfo.location}</div>
              </div>
            </div>
          </div>
          
          <div class="hero-actions">
            <a href="/programme" class="btn btn-primary">View Programme</a>
            <a href="/stalls" class="btn btn-secondary">Browse Stalls</a>
            <a href="/visitor-info" class="btn btn-secondary">Visitor Information</a>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Welcome Section -->
    <section class="welcome">
      <div class="container">
        <div class="welcome-content">
          <h2 class="section-title">Welcome</h2>
          <div class="welcome-message">
            {eventInfo.welcomeMessage.split('\n\n').map((paragraph, index) => (
              <p key={index}>{paragraph}</p>
            ))}
          </div>
        </div>
      </div>
    </section>
    
    <!-- Highlights Section -->
    <section class="highlights">
      <div class="container">
        <h2 class="section-title centered">Event Highlights</h2>
        <div class="highlights-grid">
          <div class="highlight-card">
            <div class="highlight-icon">🎅</div>
            <h3>Santa's Grotto</h3>
            <p>Visit Santa in his grotto! Pre-booked slots every half hour with limited walk-in places.</p>
            <a href="/programme#grotto" class="highlight-link">Learn more →</a>
          </div>
          <div class="highlight-card">
            <div class="highlight-icon">🎠</div>
            <h3>Fairground Rides</h3>
            <p>Swing chairs, climbing wall, penalty shootout and bouncy castle from Ellis Amusements.</p>
            <a href="/programme#fairground" class="highlight-link">Learn more →</a>
          </div>
          <div class="highlight-card">
            <div class="highlight-icon">🎵</div>
            <h3>Live Performances</h3>
            <p>School Choir and Ashford Youth Jazz Orchestra providing festive entertainment.</p>
            <a href="/programme" class="highlight-link">View times →</a>
          </div>
          <div class="highlight-card">
            <div class="highlight-icon">🛍️</div>
            <h3>{allStalls.length}+ Stalls</h3>
            <p>Handmade gifts, crafts, treats and more from independent stallholders and school stalls.</p>
            <a href="/stalls" class="highlight-link">Browse stalls →</a>
          </div>
          <div class="highlight-card">
            <div class="highlight-icon">🎟️</div>
            <h3>Raffle</h3>
            <p>Super raffle (£5) with amazing prizes plus everyday raffle (£1). Draw at 3:15pm.</p>
            <a href="/raffle" class="highlight-link">See prizes →</a>
          </div>
          <div class="highlight-card">
            <div class="highlight-icon">☕</div>
            <h3>Nordic Café</h3>
            <p>Traditional Christmas café in Friars Hall serving hot food, homemade cakes and refreshments.</p>
            <a href="/visitor-info" class="highlight-link">Visitor info →</a>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Quick Programme Preview -->
    <section class="programme-preview">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Today's Programme</h2>
          <a href="/programme" class="view-all">View full programme →</a>
        </div>
        <div class="programme-list">
          {programme.slice(0, 4).map(item => (
            <div class="programme-item">
              <div class="programme-time">{item.time}</div>
              <div class="programme-details">
                <h3>{item.name}</h3>
                <p class="programme-location">📍 {item.location}</p>
                <span class="programme-category">{item.category}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</BaseLayout>

<style>
  .hero {
    position: relative;
    background: linear-gradient(135deg, var(--warm-cream) 0%, #f0ebe0 50%, var(--warm-cream) 100%);
    padding: 4rem 0 3rem;
    overflow: hidden;
    border-bottom: 2px solid var(--subtle-border);
  }
  
  .hero-decoration {
    position: absolute;
    font-size: 3rem;
    opacity: 0.3;
    pointer-events: none;
    animation: float 6s ease-in-out infinite;
  }
  
  .hero-decoration-1 {
    top: 2rem;
    left: 2rem;
    animation-delay: 0s;
  }
  
  .hero-decoration-2 {
    top: 3rem;
    right: 3rem;
    animation-delay: 2s;
  }
  
  .hero-decoration-3 {
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    animation-delay: 4s;
  }
  
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
  }
  
  .hero-container {
    position: relative;
    z-index: 1;
  }
  
  .hero-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }
  
  .hero-eyebrow {
    color: var(--accent);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.875rem;
    margin-bottom: 1rem;
  }
  
  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin-bottom: 0.75rem;
    font-weight: 700;
  }
  
  .hero-subtitle {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    color: var(--text-secondary);
    font-family: var(--font-serif);
    font-style: italic;
    margin-bottom: 2.5rem;
  }
  
  .hero-details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  
  .hero-detail-card {
    background: var(--surface);
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    border: 2px solid var(--subtle-border);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-align: left;
    box-shadow: 0 2px 8px rgba(22, 41, 74, 0.05);
  }
  
  .hero-detail-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }
  
  .hero-detail-label {
    font-size: 0.75rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }
  
  .hero-detail-value {
    font-weight: 600;
    color: var(--navy);
  }
  
  .hero-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.75rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.2s ease;
    border: 2px solid transparent;
    min-height: 48px;
  }
  
  .btn-primary {
    background: var(--accent);
    color: var(--white);
  }
  
  .btn-primary:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(161, 24, 52, 0.3);
  }
  
  .btn-secondary {
    background: var(--surface);
    color: var(--navy);
    border-color: var(--subtle-border);
  }
  
  .btn-secondary:hover {
    border-color: var(--navy);
    background: var(--surface-alt);
    transform: translateY(-2px);
  }
  
  .welcome {
    padding: 3rem 0;
  }
  
  .welcome-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }
  
  .section-title {
    font-size: clamp(2rem, 4vw, 2.5rem);
    margin-bottom: 1.5rem;
    color: var(--navy);
  }
  
  .section-title.centered {
    text-align: center;
  }
  
  .welcome-message p {
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 1.25rem;
  }
  
  .highlights {
    padding: 3rem 0;
    background: linear-gradient(to bottom, transparent 0%, rgba(229, 224, 214, 0.3) 100%);
  }
  
  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }
  
  .highlight-card {
    background: var(--surface);
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--subtle-border);
    box-shadow: 0 2px 12px rgba(22, 41, 74, 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  
  .highlight-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 6px 20px rgba(22, 41, 74, 0.1);
  }
  
  .highlight-icon {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
  }
  
  .highlight-card h3 {
    font-size: 1.4rem;
    margin-bottom: 0.75rem;
    color: var(--navy);
  }
  
  .highlight-card p {
    color: var(--text-secondary);
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }
  
  .highlight-link {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9rem;
  }
  
  .highlight-link:hover {
    text-decoration: underline;
  }
  
  .programme-preview {
    padding: 3rem 0 4rem;
  }
  
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }
  
  .view-all {
    color: var(--accent);
    font-weight: 600;
  }
  
  .view-all:hover {
    text-decoration: underline;
  }
  
  .programme-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  .programme-item {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 1.5rem;
    background: var(--surface);
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-lg);
    border-left: 4px solid var(--evergreen);
    border: 1px solid var(--subtle-border);
    align-items: center;
  }
  
  .programme-time {
    font-weight: 600;
    color: var(--navy);
    font-family: var(--font-sans);
  }
  
  .programme-details h3 {
    font-size: 1.2rem;
    margin-bottom: 0.375rem;
    color: var(--navy);
  }
  
  .programme-location {
    color: var(--text-secondary);
    font-size: 0.875rem;
    margin-bottom: 0.375rem;
  }
  
  .programme-category {
    display: inline-block;
    background: rgba(35, 99, 75, 0.1);
    color: var(--evergreen);
    padding: 0.25rem 0.625rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
  }
  
  @media (max-width: 640px) {
    .hero-details {
      grid-template-columns: 1fr;
    }
    
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    
    .btn {
      width: 100%;
    }
    
    .highlights-grid {
      grid-template-columns: 1fr;
    }
    
    .programme-item {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    
    .section-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
