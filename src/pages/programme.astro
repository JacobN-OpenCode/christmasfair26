---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { programme } from '../data/fairData';
---

<BaseLayout title="Programme | Ashford School Christmas Fair 2026">
  <Navbar />
  
  <main>
    <section class="page-header">
      <div class="container">
        <h1 class="page-title">Digital Programme</h1>
        <p class="page-subtitle">Events, performances and attractions happening on the day</p>
      </div>
    </section>
    
    <section class="programme-section">
      <div class="container">
        <div class="filters">
          <button class="filter-btn active" data-filter="all">All</button>
          <button class="filter-btn" data-filter="Performance">Performances</button>
          <button class="filter-btn" data-filter="Attraction">Attractions</button>
          <button class="filter-btn" data-filter="Activity">Activities</button>
          <button class="filter-btn" data-filter="Event">Events</button>
        </div>
        
        <div class="programme-grid">
          {programme.map(item => (
            <article class="programme-card" data-category={item.category} id={item.id}>
              <div class="programme-card-header">
                <div>
                  <h2 class="programme-card-title">{item.name}</h2>
                  <span class="programme-card-category">{item.category}</span>
                </div>
                <div class="programme-card-time">{item.time}</div>
              </div>
              <div class="programme-card-body">
                <p class="programme-card-location">📍 {item.location}</p>
                <p class="programme-card-desc">{item.description}</p>
              </div>
            </article>
          ))}
        </div>
        
        <div class="print-section">
          <button onclick="window.print()" class="print-btn">🖨️ Print Programme</button>
          <p class="print-note">This programme is print-friendly. Use your browser's print function.</p>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.programme-card');
  
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      
      const filter = btn.getAttribute('data-filter');
      
      cards.forEach(card => {
        if (filter === 'all' || card.getAttribute('data-category') === filter) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .page-header {
    background: linear-gradient(135deg, var(--navy) 0%, #0f1f3a 100%);
    color: var(--white);
    padding: 3rem 0 2rem;
    text-align: center;
  }
  
  .page-title {
    color: var(--white);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    margin-bottom: 0.5rem;
  }
  
  .page-subtitle {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.1rem;
    margin: 0;
  }
  
  .programme-section {
    padding: 2.5rem 0 4rem;
  }
  
  .filters {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
    justify-content: center;
  }
  
  .filter-btn {
    padding: 0.5rem 1.25rem;
    background: var(--surface);
    border: 2px solid var(--subtle-border);
    border-radius: var(--radius-md);
    color: var(--navy);
    font-weight: 500;
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }
  
  .filter-btn:hover {
    border-color: var(--navy);
  }
  
  .filter-btn.active {
    background: var(--navy);
    border-color: var(--navy);
    color: var(--white);
  }
  
  .programme-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 3rem;
  }
  
  .programme-card {
    background: var(--surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--subtle-border);
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(22, 41, 74, 0.04);
  }
  
  .programme-card-header {
    background: linear-gradient(to right, rgba(35, 99, 75, 0.08) 0%, transparent 100%);
    padding: 1.25rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    border-bottom: 1px solid var(--subtle-border);
    flex-wrap: wrap;
  }
  
  .programme-card-title {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--navy);
  }
  
  .programme-card-category {
    display: inline-block;
    background: rgba(35, 99, 75, 0.15);
    color: var(--evergreen);
    padding: 0.25rem 0.75rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
  }
  
  .programme-card-time {
    font-weight: 600;
    color: var(--accent);
    font-size: 1rem;
    white-space: nowrap;
  }
  
  .programme-card-body {
    padding: 1.25rem 1.5rem;
  }
  
  .programme-card-location {
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
  }
  
  .programme-card-desc {
    color: var(--text-primary);
    margin: 0;
    line-height: 1.7;
  }
  
  .print-section {
    text-align: center;
    padding-top: 2rem;
    border-top: 2px solid var(--subtle-border);
  }
  
  .print-btn {
    background: var(--navy);
    color: var(--white);
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }
  
  .print-btn:hover {
    background: #0f1f3a;
  }
  
  .print-note {
    color: var(--text-secondary);
    font-size: 0.875rem;
    margin: 0;
  }
  
  @media print {
    .navbar,
    .footer,
    .filters,
    .print-section {
      display: none !important;
    }
    
    .page-header {
      background: white !important;
      color: black !important;
      padding: 1rem 0;
    }
    
    .page-title {
      color: black !important;
      font-size: 2rem;
    }
    
    .page-subtitle {
      color: black !important;
    }
    
    .programme-card {
      break-inside: avoid;
      border: 2px solid #ccc;
      margin-bottom: 1rem;
    }
    
    .programme-card-header {
      background: #f5f5f5 !important;
    }
  }
  
  @media (max-width: 640px) {
    .programme-card-header {
      flex-direction: column;
    }
    
    .filters {
      justify-content: flex-start;
    }
  }
</style>
