---
import { eventInfo } from '../data/fairData';
---

<footer class="footer">
  <div class="container footer-container">
    <div class="footer-main">
      <div class="footer-brand">
        <h3 class="footer-brand-name">Ashford School Christmas Fair 2026</h3>
        <p class="footer-brand-tagline">A magical day of festive fun for the whole family</p>
      </div>
      
      <div class="footer-info">
        <div class="footer-section">
          <h4>Event Details</h4>
          <p><strong>{eventInfo.date}</strong></p>
          <p>{eventInfo.time}</p>
          <p>{eventInfo.location}</p>
        </div>
        
        <div class="footer-section">
          <h4>Contact</h4>
          <p><a href={`mailto:${eventInfo.pfaEmail}`}>{eventInfo.pfaEmail}</a></p>
          <p>Instagram: {eventInfo.pfaInstagram} {eventInfo.instagramTbd && <span class="tbd">(TBC)</span>}</p>
        </div>
        
        <div class="footer-section">
          <h4>Quick Links</h4>
          <ul>
            <li><a href="/programme">Programme</a></li>
            <li><a href="/stalls">Stalls</a></li>
            <li><a href="/visitor-info">Visitor Information</a></li>
            <li><a href="/raffle">Raffle</a></li>
          </ul>
        </div>
      </div>
    </div>
    
    <div class="footer-bottom">
      <p class="footer-credit">
        Website designed and built by <a href="https://jacob.navaratne.uk/" target="_blank" rel="noopener noreferrer">Jacob Navaratne</a> - Year 10 Student at Ashford School
      </p>
      <p class="footer-school">
        <a href={eventInfo.schoolUrl} target="_blank" rel="noopener noreferrer">{eventInfo.schoolName}</a> | Ashford School Parents & Friends Association
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: linear-gradient(135deg, var(--navy) 0%, #0a1528 100%);
    color: rgba(255, 255, 255, 0.9);
    border-top: 3px solid var(--gold);
    margin-top: 4rem;
  }
  
  .footer-container {
    padding-top: 3rem;
    padding-bottom: 2rem;
  }
  
  .footer-main {
    margin-bottom: 2rem;
  }
  
  .footer-brand {
    margin-bottom: 2rem;
    text-align: center;
  }
  
  .footer-brand-name {
    color: var(--white);
    font-family: var(--font-serif);
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
    font-weight: 700;
  }
  
  .footer-brand-tagline {
    color: rgba(255, 255, 255, 0.8);
    font-style: italic;
    margin: 0;
  }
  
  .footer-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }
  
  .footer-section h4 {
    color: var(--gold);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .footer-section p {
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
  }
  
  .footer-section a {
    color: rgba(255, 255, 255, 0.9);
    transition: color 0.2s ease;
  }
  
  .footer-section a:hover {
    color: var(--gold);
  }
  
  .footer-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .footer-section li {
    margin-bottom: 0.5rem;
  }
  
  .tbd {
    opacity: 0.7;
    font-style: italic;
  }
  
  .footer-bottom {
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    text-align: center;
  }
  
  .footer-bottom p {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
  }
  
  .footer-bottom a {
    color: var(--gold);
    transition: opacity 0.2s ease;
  }
  
  .footer-bottom a:hover {
    opacity: 0.9;
  }
  
  @media (max-width: 640px) {
    .footer-info {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    
    .footer-brand-name {
      font-size: 1.5rem;
    }
  }
</style>
